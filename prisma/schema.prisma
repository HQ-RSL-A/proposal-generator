generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["proposals"]
}

// ---------- Enums ----------

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_SIGNED
  SIGNED
  DECLINED
  EXPIRED
  VOIDED

  @@schema("proposals")
}

enum PaymentStatus {
  NOT_REQUIRED
  AWAITING
  PROCESSING
  PAID
  FAILED
  SESSION_EXPIRED

  @@schema("proposals")
}

enum PartyRole {
  ADMIN_SIGNER
  CLIENT_SIGNER

  @@schema("proposals")
}

enum SignatureType {
  DRAWN
  TYPED
  PRE_APPLIED

  @@schema("proposals")
}

enum AuditEventType {
  PROPOSAL_CREATED
  PROPOSAL_SENT
  PROPOSAL_REVISED
  EMAIL_SENT
  EMAIL_DELIVERED
  EMAIL_OPENED
  EMAIL_BOUNCED
  PAGE_VIEWED
  TIER_SELECTED
  ESIGN_CONSENTED
  PARTY_SIGNED
  ALL_SIGNED
  PARTY_DECLINED
  PROPOSAL_VOIDED
  PROPOSAL_EXPIRED
  CHECKOUT_CREATED
  PAYMENT_PAID
  PAYMENT_PROCESSING
  PAYMENT_FAILED
  CHECKOUT_EXPIRED
  PDF_GENERATED
  NOTION_SYNCED
  STRIPE_METADATA_ATTACHED
  REMINDER_SENT

  @@schema("proposals")
}

enum EmailStatus {
  SENT
  DELIVERED
  OPENED
  BOUNCED
  COMPLAINED
  FAILED

  @@schema("proposals")
}

enum JobType {
  SEND_EMAIL
  NOTION_SYNC
  STRIPE_METADATA
  GENERATE_PDF

  @@schema("proposals")
}

enum JobStatus {
  PENDING
  PROCESSING
  DONE
  DEAD

  @@schema("proposals")
}

enum UserRole {
  ADMIN
  MEMBER

  @@schema("proposals")
}

// ---------- Models ----------

// Allowlist: only rows here can sign in (rsla.io Google accounts only).
model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  role        UserRole  @default(MEMBER)
  avatarUrl   String?
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@schema("proposals")
}

model MsaVersion {
  id           String     @id @default(cuid())
  version      String     @unique
  bodyMarkdown String
  sha256       String
  createdAt    DateTime   @default(now())
  proposals    Proposal[]

  @@schema("proposals")
}

model Proposal {
  id            String         @id @default(cuid())
  versionNumber Int            @default(1)
  parentId      String?
  parent        Proposal?      @relation("ProposalRevisions", fields: [parentId], references: [id])
  revisions     Proposal[]     @relation("ProposalRevisions")

  title         String
  status        ProposalStatus @default(DRAFT)
  paymentStatus PaymentStatus  @default(NOT_REQUIRED)

  // Editable until send; frozen snapshot is the legal record after send
  tokens        Json
  paymentConfig Json
  // Per-proposal Track Record (intro + case studies); null = legacy default. Frozen at send.
  trackRecord   Json?
  msaVersionId  String
  msaVersion    MsaVersion     @relation(fields: [msaVersionId], references: [id])

  frozenContent Json?
  contentHash   String?
  frozenAt      DateTime?

  validUntil       DateTime?
  selectedTierId   String?
  // Client's chosen add-on ids at sign time (offer lives in frozenContent.paymentConfig.addOns)
  selectedAddOnIds Json      @default("[]")

  stripeCheckoutSessionId String? @unique
  stripeCustomerId        String?
  notionPageId            String?

  sentAt      DateTime?
  completedAt DateTime?
  paidAt      DateTime?
  voidedAt    DateTime?
  voidReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parties     Party[]
  signatures  Signature[]
  auditEvents AuditEvent[]
  emailLogs   EmailLog[]
  payment     Payment?
  documents   GeneratedDocument[]
  jobs        PendingJob[]

  @@index([status])
  @@index([validUntil])
  @@index([parentId])
  @@schema("proposals")
}

model Party {
  id         String    @id @default(cuid())
  proposalId String
  proposal   Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  role       PartyRole
  name       String
  email      String
  payer      Boolean   @default(false)
  orderIndex Int       @default(0)

  // SHA-256 of the raw signing token; raw token only ever lives in the email URL.
  // Null for ADMIN_SIGNER (auto-signed at send, never gets a link).
  signingTokenHash String?   @unique
  tokenExpiresAt   DateTime?

  signedAt       DateTime?
  declinedAt     DateTime?
  declinedReason String?

  emailBounced    Boolean @default(false)
  emailComplained Boolean @default(false)

  createdAt DateTime @default(now())

  signature   Signature?
  emailLogs   EmailLog[]
  auditEvents AuditEvent[]

  @@unique([proposalId, email])
  @@index([proposalId])
  @@schema("proposals")
}

model Signature {
  id             String        @id @default(cuid())
  proposalId     String
  proposal       Proposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  partyId        String        @unique
  party          Party         @relation(fields: [partyId], references: [id], onDelete: Cascade)
  type           SignatureType
  imageBlobUrl   String
  adoptedName    String
  signerTitle    String?
  signerCompany  String?
  fontFamily     String?
  esignConsented Boolean       @default(false)
  consentedAt    DateTime?
  signedAt       DateTime      @default(now())
  /** Client-side tap times for the two-place ceremony (proposal acceptance + MSA execution). */
  stampedProposalAt  DateTime?
  stampedAgreementAt DateTime?
  ipAddress      String?
  userAgent      String?

  @@index([proposalId])
  @@schema("proposals")
}

model AuditEvent {
  id         String         @id @default(cuid())
  proposalId String
  proposal   Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  partyId    String?
  party      Party?         @relation(fields: [partyId], references: [id], onDelete: SetNull)
  eventType  AuditEventType
  metadata   Json?
  occurredAt DateTime       @default(now())

  @@index([proposalId, occurredAt])
  @@schema("proposals")
}

model EmailLog {
  id              String      @id @default(cuid())
  proposalId      String
  proposal        Proposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  partyId         String?
  party           Party?      @relation(fields: [partyId], references: [id], onDelete: SetNull)
  templateId      String
  recipient       String
  subject         String
  resendMessageId String?     @unique
  status          EmailStatus @default(SENT)
  error           String?
  sentAt          DateTime    @default(now())
  deliveredAt     DateTime?
  openedAt        DateTime?
  bouncedAt       DateTime?

  @@index([proposalId])
  @@schema("proposals")
}

model Payment {
  id                    String    @id @default(cuid())
  proposalId            String    @unique
  proposal              Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  stripeSessionId       String    @unique
  stripeCustomerId      String?
  stripePaymentIntentId String?
  stripeSubscriptionId  String?
  amountTotalCents      Int?
  currency              String    @default("usd")
  paymentMethod         String?
  status                String
  paidAt                DateTime?
  receiptUrl            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@schema("proposals")
}

model GeneratedDocument {
  id          String   @id @default(cuid())
  proposalId  String
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  blobPath    String
  blobUrl     String
  sha256      String
  sizeBytes   Int
  isFinal     Boolean  @default(false)
  generatedAt DateTime @default(now())

  @@index([proposalId])
  @@schema("proposals")
}

model PendingJob {
  id          String    @id @default(cuid())
  jobType     JobType
  status      JobStatus @default(PENDING)
  payload     Json
  proposalId  String?
  proposal    Proposal? @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?
  scheduledAt DateTime  @default(now())
  processingAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([proposalId])
  @@schema("proposals")
}

model WebhookEvent {
  id          String   @id @default(cuid())
  source      String
  externalId  String   @unique
  eventType   String
  proposalId  String?
  processedAt DateTime @default(now())

  @@schema("proposals")
}

model AdminSettings {
  id                   String        @id @default("singleton")
  signatureBlobUrl     String?
  signatureAdoptedName String?
  signatureType        SignatureType @default(DRAWN)
  updatedAt            DateTime      @updatedAt

  @@schema("proposals")
}

model CronLog {
  id         String   @id @default(cuid())
  path       String
  ranAt      DateTime @default(now())
  durationMs Int
  ok         Boolean
  note       String?

  @@index([path, ranAt])
  @@schema("proposals")
}
