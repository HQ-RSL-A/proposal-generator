# Database — Supabase Postgres (proposals schema lives alongside expenseVault)
DATABASE_URL="postgresql://postgres:...@db.<project>.supabase.co:5432/postgres"
# Vercel prod only (direct host doesn't resolve from Vercel):
# DATABASE_URL_POOLER="postgresql://postgres.<project>:...@aws-0-us-west-1.pooler.supabase.com:6543/postgres"

# NextAuth v5
AUTH_SECRET="openssl rand -base64 32"
AUTH_TRUST_HOST=true

# Google OAuth — client "Proposal Generator" in rsla-2026
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vercel Blob (private storage for signatures + executed PDFs)
BLOB_READ_WRITE_TOKEN=""

# Stripe — TEST keys locally, LIVE only in Vercel
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
# RESEND_FROM="Rahul Lalia, RSL/A <proposals@send.rsla.io>"

# Notion internal integration "proposalGenerator"
NOTION_API_KEY=""

# Cron auth (Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# Base URL for signing links
NEXT_PUBLIC_APP_URL="http://localhost:1235"
